{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Open Claude",
  "version": "1.0.10",
  "identifier": "com.marlonschmitz.openclaude",
  "build": {
    "beforeDevCommand": "cargo build --manifest-path src-tauri/Cargo.toml --bin ocui-sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Open Claude",
        "width": 820,
        "height": 580,
        "minWidth": 520,
        "minHeight": 360,
        "decorations": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "app",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVCMjdBQjM2NkE5NTY4OEEKUldTS2FKVnFOcXNuVzJ5SWhkYnROYVUxQkhzZktEVTl6TmQ3bThYNStWcG5UNC95VnF3R3hhMEQK",
      "endpoints": [
        "https://github.com/marlon-schmitz-289/open-claude/releases/latest/download/latest.json"
      ]
    }
  }
}
